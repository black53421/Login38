<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The in-game helper: what it reads out of the client, what it decides, and what it
    writes back. Nothing here draws — the notification overlay is a window of the
    launcher's own and lives in Login38.App, so this project stays testable headless.
  -->

  <ItemGroup>
    <!-- The toggles' byte tables and shellcode are internal: they are facts about one
         client build, not API. The tests pin them, so they need to see them. -->
    <InternalsVisibleTo Include="Login38.Aux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Login38.Core\Login38.Core.csproj" />
    <ProjectReference Include="..\Login38.Interop\Login38.Interop.csproj" />
    <ProjectReference Include="..\Login38.Patching\Login38.Patching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- l38ddraw.dll stays C++: it is an in-process DirectDraw present hook,
         which managed code cannot provide. Embedded and dropped at runtime. -->
    <EmbeddedResource Include="..\..\native\ddraw_inproc\build\l38ddraw.dll"
                      Condition="Exists('..\..\native\ddraw_inproc\build\l38ddraw.dll')"
                      LogicalName="l38ddraw.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item lists the helper window offers. Shipped inside the assembly and written
         out beside the launcher on first run, so a player can edit it without a rebuild. -->
    <EmbeddedResource Include="Settings\linhelperZ.ini" LogicalName="linhelperZ.ini" />
  </ItemGroup>

</Project>
