<!--
    The library's own colour tokens, repointed at this palette.

    WPF-UI draws its controls out of a fixed set of named brushes. Retemplating each of
    them would mean copying a template that has parts this code does not own — a NumberBox
    has spin buttons wired to PART names, an InfoBar has a severity switch, a TitleBar has
    the caption buttons the window manager needs. Replacing the brushes instead recolours
    every one of them, including the ones no window uses yet, and keeps the behaviour.

    Every key here is a real key in the library. A name that is not is a dead entry that
    silently changes nothing, which is exactly the kind of half-applied theme this is meant
    to avoid — so a test asserts that each of them was defined before this dictionary
    replaced it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        What this file needs, named rather than assumed.

        A StaticResource inside a merged dictionary does not reliably reach a *sibling*
        merged dictionary: it resolves against its own dictionary and what that dictionary
        merges. So each file merges what it uses. The addresses are the same ones the theme
        merges, and WPF hands back the same dictionary for an address it has already
        loaded — so this costs a lookup, not a second copy.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Login38.Ui;component/Theme/Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================================================================== The field -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Colour.Surface.Base}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Colour.Surface.Base}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Colour.Surface.Void}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource Colour.Surface.Base}" />

    <!-- ========================================================================== Ink -->

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Colour.Ink.Primary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Colour.Ink.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Colour.Ink.Tertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Colour.Ink.Disabled}" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource Colour.Ink.Tertiary}" />

    <!-- ===================================================================== Controls -->

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Colour.Surface.Hover}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Colour.Surface.Press}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource Colour.Surface.Sunken}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource Colour.Surface.Raised}" />

    <!-- What the user types into reads as cut in, so it is darker than the field rather
         than lighter. -->
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Colour.Surface.Sunken}" />

    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{StaticResource Colour.Ink.Tertiary}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="{StaticResource Colour.Ink.Disabled}" />

    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource Colour.Surface.Sunken}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Colour.Surface.Hover}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{StaticResource Colour.Surface.Press}" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="Transparent" />

    <!-- ======================================================================== Edges -->

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Colour.Line.Subtle}" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="{StaticResource Colour.Line.Subtle}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{StaticResource Colour.Line.Subtle}" />

    <!-- Fluent draws these as vertical gradients so a control catches light along its top
         edge. Flat here: this palette is an instrument panel, and the one thing allowed
         to look lit is the accent. -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{StaticResource Colour.Accent}" />

    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource Colour.Accent}" />

    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource Colour.Line.Subtle}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Colour.Line.Subtle}" />

    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="CheckBoxCheckBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <!-- Five more names that look like colours of this kind — ButtonBorderBrush,
         AccentButtonBorderBrush, ToggleButtonBorderBrush, ComboBoxBorderBrush and
         TextControlBorderBrush — are property names inside the library rather than keys in
         its dark theme. Overriding them changed nothing at all, which a test now refuses. -->
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{StaticResource Colour.Line.Strong}" />

    <!-- ======================================================================= Accent -->

    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource Colour.Accent.Deep}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource Colour.Accent.Shade}" />

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Colour.Accent.Deep}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Colour.Accent.Shade}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Colour.Accent.Deep}" />

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Colour.Accent.Bright}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Colour.Accent.Deep}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{StaticResource Colour.Ink.Disabled}" />

    <!-- Text drawn on top of the accent. Very dark rather than white — the accent here is
         bright enough that white on it is the weaker contrast of the two. -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Colour.Accent.Ink}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Colour.Accent.Ink}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource Colour.Ink.Disabled}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource Colour.Accent.Ink}" />

    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="{StaticResource Colour.Accent.Bright}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{StaticResource Colour.Accent.Deep}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="{StaticResource Colour.Accent.Shade}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush" Color="{StaticResource Colour.Line.Subtle}" />

    <!-- ========================================================================= Cards -->

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Colour.Surface.Base}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Colour.Line.Subtle}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource Colour.Line.Subtle}" />

    <!-- ======================================================================== Subtle -->

    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Colour.Surface.Hover}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Colour.Surface.Press}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

    <!-- ========================================================================= Focus -->

    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{StaticResource Colour.Accent.Ink}" />
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{StaticResource Colour.Accent}" />

    <!-- ======================================================================= Signals -->

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource Colour.Signal.Good}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{StaticResource Colour.Signal.Good.Wash}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource Colour.Signal.Warn}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource Colour.Signal.Warn.Wash}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource Colour.Signal.Bad}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource Colour.Signal.Bad.Wash}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{StaticResource Colour.Accent.Wash}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{StaticResource Colour.Ink.Secondary}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="{StaticResource Colour.Surface.Hover}" />

    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{StaticResource Colour.Signal.Bad.Wash}" />
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{StaticResource Colour.Signal.Warn.Wash}" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{StaticResource Colour.Signal.Good.Wash}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{StaticResource Colour.Accent.Wash}" />

</ResourceDictionary>
