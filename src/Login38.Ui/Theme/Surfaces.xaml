<!--
    The shapes a page is built out of: groups, labelled rows, cards, panels, the status
    dot, and the window chrome around all of it.

    Everything above this point styles a control the framework or the library already had.
    Everything here is a shape both applications repeat, given a name once so that the
    fortieth group on the sixth page looks like the first.

    The library's own controls — the card, the notice bar, the ring, the title bar — are
    styled in Theme.xaml instead. A style that derives from one of theirs has to be an
    entry of the dictionary that merges theirs, not a sibling of it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:Login38.Ui">

    <!--
        What this file needs, named rather than assumed.

        A StaticResource inside a merged dictionary does not reliably reach a *sibling*
        merged dictionary: it resolves against its own dictionary and what that dictionary
        merges. So each file merges what it uses. The addresses are the same ones the theme
        merges, and WPF hands back the same dictionary for an address it has already
        loaded — so this costs a lookup, not a second copy.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Login38.Ui;component/Theme/Palette.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Login38.Ui;component/Theme/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Login38.Ui;component/Theme/Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== Section -->

    <Style TargetType="{x:Type local:Section}">
        <Setter Property="Margin" Value="0,0,0,22" />
        <Setter Property="Foreground" Value="{StaticResource Ink.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Section}">
                    <!-- A grid rather than a stack, so that a group given the tall row on
                         a page hands that height down to what is inside it. A stack gives
                         its children the height they ask for and nothing more, which on a
                         page whose point is a list left the list its empty size. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- A short accent tick before the title. Cheaper than a rule
                                 above the group and it points at the words rather than
                                 boxing them in. -->
                            <Border Grid.Column="0"
                                    Width="3"
                                    Height="12"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Accent}" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Subtitle}"
                                       VerticalAlignment="Center"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>

                        <TextBlock x:Name="Note"
                                   Grid.Row="1"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="11,0,0,10"
                                   Text="{Binding Note, RelativeSource={RelativeSource TemplatedParent}}" />

                        <ContentPresenter Grid.Row="2" Margin="11,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- No note means no gap where one would be, rather than an empty
                             line that pushes every group down by the height of a caption. -->
                        <Trigger Property="Note" Value="">
                            <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== Field row -->

    <Style TargetType="{x:Type local:FieldRow}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{StaticResource Ink.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FieldRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Width="{TemplateBinding LabelWidth}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Label}"
                                       HorizontalAlignment="Left"
                                       TextWrapping="Wrap"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="Note"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,1,0,0"
                                       Text="{Binding Note, RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Note" Value="">
                            <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== Status dot -->

    <Style TargetType="{x:Type local:StatusDot}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusDot}">
                    <Grid>
                        <!-- The glow is a second, larger, faint circle rather than a blur
                             effect. A DropShadowEffect on eight pixels costs a render
                             target per dot, and a list of servers would pay for one each. -->
                        <Ellipse x:Name="Halo"
                                 Margin="-4"
                                 Opacity="0.28"
                                 Visibility="Collapsed"
                                 Fill="{Binding Fill, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Ellipse Fill="{Binding Fill, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLit" Value="True">
                            <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================================== Panels -->

    <!-- A block of content lifted off the field. The everyday container: a list, a group
         of switches, a report. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The same, cut in rather than raised. For anything that is output rather than
         input: a report, a log, a list of what was found. -->
    <Style x:Key="Panel.Sunken" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Background" Value="{StaticResource Surface.Sunken}" />
    </Style>

    <!-- The one panel on a screen that is the subject of it. Marked with an accent edge
         along the top rather than a heavier border. -->
    <Style x:Key="Panel.Feature" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="BorderBrush" Value="{StaticResource Line.Strong}" />
        <Setter Property="BorderThickness" Value="1,2,1,1" />
    </Style>

    <!-- A rule under a heading, fading out to the right. -->
    <Style x:Key="Rule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line.Fade}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

</ResourceDictionary>
