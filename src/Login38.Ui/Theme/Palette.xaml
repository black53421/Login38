<!--
    Every colour in the two applications.

    Named for the job rather than for the colour, so a row that is "raised" stays raised
    when the shade behind it changes. The literal shades appear once each, here.

    The scheme is a dark instrument panel with one high-chroma accent: the eye has a single
    place to land, which on a launcher is the button that starts the game and in the helper
    is whatever is currently switched on. A second accent colour would take that away.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================================================================== Surfaces -->

    <!-- Behind everything. Nearly black, but not black: a true black panel against a dark
         desktop reads as a hole rather than as a window. -->
    <Color x:Key="Colour.Surface.Void">#FF070A0F</Color>

    <!-- The window's own field. -->
    <Color x:Key="Colour.Surface.Base">#FF0B0E14</Color>

    <!-- A card, a row, a panel: anything sitting on the field. -->
    <Color x:Key="Colour.Surface.Raised">#FF131924</Color>

    <!-- Anything the user types into, which reads as cut into the surface rather than
         laid on it. -->
    <Color x:Key="Colour.Surface.Sunken">#FF090C12</Color>

    <!-- Under the pointer. -->
    <Color x:Key="Colour.Surface.Hover">#FF1A2130</Color>

    <!-- Held down. Darker than hover, not lighter: pressing pushes in. -->
    <Color x:Key="Colour.Surface.Press">#FF0E131C</Color>

    <!-- Chosen, and still chosen when the list loses focus. -->
    <Color x:Key="Colour.Surface.Selected">#FF16202F</Color>

    <!-- ======================================================================== Lines -->

    <!-- Separates without being seen. -->
    <Color x:Key="Colour.Line.Subtle">#FF1C2230</Color>

    <!-- The edge of something interactive, and on this scheme the only thing that says
         where a field ends: a text box is a hair darker than the panel it sits on, which
         is a difference of one part in twenty and nothing to find an edge by. Held at
         three to one against the surfaces so the edge does the work the fill cannot. -->
    <Color x:Key="Colour.Line.Strong">#FF626C7E</Color>

    <!-- The edge of something focused or ticked, short of the accent itself. A tick box
         is small, and a box nobody can find is a setting nobody changes. -->
    <Color x:Key="Colour.Line.Focus">#FF687A92</Color>

    <!-- ========================================================================== Ink -->

    <!--
        Three shades that are all meant to be read, and one that is not.

        Tertiary is the line of explanation under a heading, the note beside a tab, the
        path along the bottom. It was two levels down from primary by eye and came out at
        three to one, which is under the floor for text — the sentence explaining what a
        setting does was the hardest thing in the window to read. All three are held at
        four and a half to one against every surface they are ever drawn on.
    -->
    <Color x:Key="Colour.Ink.Primary">#FFE6EDF3</Color>
    <Color x:Key="Colour.Ink.Secondary">#FF939FAE</Color>
    <Color x:Key="Colour.Ink.Tertiary">#FF7A8B9F</Color>

    <!-- Not meant to be read, but meant to be seen: a control that has gone grey should
         still look like a control rather than like an empty space. -->
    <Color x:Key="Colour.Ink.Disabled">#FF525C6C</Color>

    <!-- ======================================================================= Accent -->

    <!-- Teal rather than the red or orange a game launcher usually reaches for. Red is
         this interface's colour for "something is wrong", and a scheme cannot spend it
         twice. -->
    <Color x:Key="Colour.Accent">#FF00E5C0</Color>
    <Color x:Key="Colour.Accent.Bright">#FF3DF3D6</Color>
    <Color x:Key="Colour.Accent.Deep">#FF00A88E</Color>
    <Color x:Key="Colour.Accent.Shade">#FF00705E</Color>

    <!-- Text on top of the accent. Very dark rather than white: the accent is bright
         enough that white on it is the lower contrast of the two. -->
    <Color x:Key="Colour.Accent.Ink">#FF06231F</Color>

    <!-- A wash of the accent, for the row that is selected or the switch that is on. -->
    <Color x:Key="Colour.Accent.Wash">#2600E5C0</Color>

    <!-- ======================================================================= Signal -->

    <Color x:Key="Colour.Signal.Good">#FF4ADE80</Color>
    <Color x:Key="Colour.Signal.Warn">#FFFBBF24</Color>
    <Color x:Key="Colour.Signal.Bad">#FFF87171</Color>
    <Color x:Key="Colour.Signal.Idle">#FF525C6C</Color>

    <Color x:Key="Colour.Signal.Good.Wash">#264ADE80</Color>
    <Color x:Key="Colour.Signal.Warn.Wash">#26FBBF24</Color>
    <Color x:Key="Colour.Signal.Bad.Wash">#26F87171</Color>

    <!-- ======================================================================= Brushes -->

    <SolidColorBrush x:Key="Surface.Void" Color="{StaticResource Colour.Surface.Void}" />
    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Colour.Surface.Base}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Colour.Surface.Raised}" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{StaticResource Colour.Surface.Sunken}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Colour.Surface.Hover}" />
    <SolidColorBrush x:Key="Surface.Press" Color="{StaticResource Colour.Surface.Press}" />
    <SolidColorBrush x:Key="Surface.Selected" Color="{StaticResource Colour.Surface.Selected}" />

    <SolidColorBrush x:Key="Line.Subtle" Color="{StaticResource Colour.Line.Subtle}" />
    <SolidColorBrush x:Key="Line.Strong" Color="{StaticResource Colour.Line.Strong}" />
    <SolidColorBrush x:Key="Line.Focus" Color="{StaticResource Colour.Line.Focus}" />

    <SolidColorBrush x:Key="Ink.Primary" Color="{StaticResource Colour.Ink.Primary}" />
    <SolidColorBrush x:Key="Ink.Secondary" Color="{StaticResource Colour.Ink.Secondary}" />
    <SolidColorBrush x:Key="Ink.Tertiary" Color="{StaticResource Colour.Ink.Tertiary}" />
    <SolidColorBrush x:Key="Ink.Disabled" Color="{StaticResource Colour.Ink.Disabled}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource Colour.Accent}" />
    <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Colour.Accent.Bright}" />
    <SolidColorBrush x:Key="Accent.Deep" Color="{StaticResource Colour.Accent.Deep}" />
    <SolidColorBrush x:Key="Accent.Shade" Color="{StaticResource Colour.Accent.Shade}" />
    <SolidColorBrush x:Key="Accent.Ink" Color="{StaticResource Colour.Accent.Ink}" />
    <SolidColorBrush x:Key="Accent.Wash" Color="{StaticResource Colour.Accent.Wash}" />

    <SolidColorBrush x:Key="Signal.Good" Color="{StaticResource Colour.Signal.Good}" />
    <SolidColorBrush x:Key="Signal.Warn" Color="{StaticResource Colour.Signal.Warn}" />
    <SolidColorBrush x:Key="Signal.Bad" Color="{StaticResource Colour.Signal.Bad}" />
    <SolidColorBrush x:Key="Signal.Idle" Color="{StaticResource Colour.Signal.Idle}" />

    <SolidColorBrush x:Key="Signal.Good.Wash" Color="{StaticResource Colour.Signal.Good.Wash}" />
    <SolidColorBrush x:Key="Signal.Warn.Wash" Color="{StaticResource Colour.Signal.Warn.Wash}" />
    <SolidColorBrush x:Key="Signal.Bad.Wash" Color="{StaticResource Colour.Signal.Bad.Wash}" />

    <!-- The panel gradient. Barely a gradient — enough that a large flat area is not
         completely flat, not enough to be seen as one. -->
    <LinearGradientBrush x:Key="Surface.Panel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Colour.Surface.Raised}" />
        <GradientStop Offset="1" Color="{StaticResource Colour.Surface.Base}" />
    </LinearGradientBrush>

    <!-- What the button that starts the game is filled with. -->
    <LinearGradientBrush x:Key="Accent.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Colour.Accent.Bright}" />
        <GradientStop Offset="1" Color="{StaticResource Colour.Accent.Deep}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Accent.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Colour.Accent.Bright}" />
        <GradientStop Offset="1" Color="{StaticResource Colour.Accent}" />
    </LinearGradientBrush>

    <!-- The rule under a section heading: solid at the heading, gone by the far edge. -->
    <LinearGradientBrush x:Key="Line.Fade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Colour.Line.Strong}" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>

    <!-- ===================================================================== Geometry -->

    <!-- Nothing is round. Square corners and a cut one are what tells the eye this is an
         instrument rather than a document, and it is the whole difference between this
         and the stock theme. -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.Slight">2</CornerRadius>

    <!-- How far the chamfer cuts across a corner. -->
    <sys:Double x:Key="Chamfer.Small">6</sys:Double>
    <sys:Double x:Key="Chamfer.Large">10</sys:Double>

    <Thickness x:Key="Border.Hairline">1</Thickness>

    <!-- The bar down the left of a selected row. Left only: a box around the selection
         competes with the row's own edges. -->
    <Thickness x:Key="Border.Marker">2,0,0,0</Thickness>

    <!-- ================================================================== Proportions -->

    <sys:Double x:Key="Control.Height">32</sys:Double>
    <sys:Double x:Key="Control.Height.Large">44</sys:Double>
    <sys:Double x:Key="Control.Height.Small">26</sys:Double>

    <!-- Wide enough for the longest value any box in either application holds: an
         inventory limit of 255, an IMG limit of 65535, a port of 65535, and the three
         parts of a key, which run to ten digits. -->
    <sys:Double x:Key="Field.Width">168</sys:Double>
    <sys:Double x:Key="Field.Width.Wide">220</sys:Double>

    <Thickness x:Key="Pad.Field">10,0,10,0</Thickness>
    <Thickness x:Key="Pad.Card">14</Thickness>
    <Thickness x:Key="Pad.Row">12,10,12,10</Thickness>
    <Thickness x:Key="Pad.Window">20</Thickness>

</ResourceDictionary>
