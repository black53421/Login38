<ui:FluentWindow x:Class="Login38.Encoder.Views.EncoderWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Login38.Encoder.ViewModels"
                 xmlns:views="clr-namespace:Login38.Encoder.Views"
                 xmlns:lui="clr-namespace:Login38.Ui;assembly=Login38.Ui"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 d:DataContext="{d:DesignInstance Type=vm:EncoderViewModel}"
                 mc:Ignorable="d"
                 Style="{StaticResource Window.Shell}"
                 WindowStartupLocation="CenterScreen"
                 Title="編碼器"
                 Width="1040"
                 Height="720"
                 MinWidth="940"
                 MinHeight="620">

    <ui:FluentWindow.Resources>
        <views:TextPresentConverter x:Key="TextPresent" />
        <views:TextEncodingNameConverter x:Key="EncodingName" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            The library's controls, adopted.

            The theme keeps these keyed rather than implicit: a style keyed on a type that
            derives from the style keyed on the same type is a style that asks for itself,
            and what comes back has no template. Turning them back into implicit styles
            here works because a window's own Resources is a different dictionary, so the
            lookup finds the theme's entry rather than the one being written.
        -->
        <Style TargetType="ui:TitleBar" BasedOn="{StaticResource Library.TitleBar}" />
        <Style TargetType="ui:TextBox" BasedOn="{StaticResource Library.TextBox}" />
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource Library.NumberBox}" />
        <Style TargetType="ui:InfoBar" BasedOn="{StaticResource Library.InfoBar}" />
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource Library.Card}" />
        <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource Library.ProgressRing}" />

        <Thickness x:Key="RowSpacing">0,0,0,8</Thickness>

        <!-- A label sitting to the left of the control it names. How wide the number
             fields are is the theme's business now; this is only the gap beside them. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

    </ui:FluentWindow.Resources>

    <!-- The window paints its own background rather than leaving it to the window's
         Background property. The control library writes that one as a local value while
         the window loads, which beats anything a style can say, and what came out was the
         library's grey and not this palette's black. Painted here it is the palette's, and
         it stays the palette's whatever the library decides. -->
    <Grid Background="{StaticResource Surface.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="44">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="3"
                            Height="16"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Accent}" />
                    <TextBlock Style="{StaticResource Text.Strong}"
                               VerticalAlignment="Center"
                               Text="天堂 3.8" />
                    <TextBlock Style="{StaticResource Text.Label}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="編碼器" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Pages down the side rather than tabs across the top. Six of them, and the two
             an operator uses least are the two whose names say least about them. -->
        <TabControl Grid.Row="1" Margin="0,4,0,0">

            <!-- ==================== Servers ==================== -->
            <TabItem Header="伺服器"
                     lui:Rail.Icon="{ui:SymbolIcon Server24}"
                     lui:Rail.Note="玩家看到的清單">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                      Text="槽位"
                                      Style="{StaticResource SectionHead}" />
                        <TextBlock Style="{StaticResource Text.Caption}" DockPanel.Dock="Top"
                                      Text="名稱留白的槽位不會出現在玩家的清單裡。"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,8" />

                        <ListBox ItemsSource="{Binding Servers}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 DisplayMemberPath="Label" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="這個伺服器" Style="{StaticResource SectionHead}" />

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="名稱" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IP" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="2" Text="埠" Style="{StaticResource FieldLabel}" />
                                <ui:NumberBox Grid.Column="3"
                                              Minimum="1"
                                              Maximum="65535"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding Port, Mode=TwoWay}" />
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==================== Client ==================== -->
            <TabItem Header="客戶端"
                     lui:Rail.Icon="{ui:SymbolIcon Games24}"
                     lui:Rail.Note="登入器要改什麼">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <Grid DataContext="{Binding Aux}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="通訊協定" Style="{StaticResource SectionHead}" />

                            <CheckBox Content="封包加密"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding PacketEncrypt, Mode=TwoWay}" />
                            <CheckBox Content="移動封包不加密"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding MovePacketPlain, Mode=TwoWay}" />
                            <CheckBox Content="防外掛"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding AntiCheatBasic, Mode=TwoWay}" />

                            <Separator Margin="0,10" />

                            <TextBlock Text="上限突破" Style="{StaticResource SectionHead}" />

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Content="背包上限"
                                          IsChecked="{Binding InventoryLimit, Mode=TwoWay}" />
                                <ui:NumberBox Grid.Column="1"
                                              Minimum="1"
                                              Maximum="999"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              IsEnabled="{Binding InventoryLimit}"
                                              Value="{Binding InventorySize, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Content="IMG 上限"
                                          IsChecked="{Binding ImageLimit, Mode=TwoWay}" />
                                <ui:NumberBox Grid.Column="1"
                                              Minimum="6295"
                                              Maximum="500000"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              IsEnabled="{Binding ImageLimit}"
                                              Value="{Binding ImageSize, Mode=TwoWay}" />
                            </Grid>

                            <CheckBox Content="血魔突破上限"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding HitPointLimit, Mode=TwoWay}" />
                            <CheckBox Content="AC／MR 突破上限"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding ArmourLimit, Mode=TwoWay}" />
                            <CheckBox Content="裝備欄位 7.6"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding EquipmentSlots, Mode=TwoWay}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Content="允許多開,上限"
                                          IsChecked="{Binding MultipleCopies, Mode=TwoWay}" />
                                <ui:NumberBox Grid.Column="1"
                                              Minimum="0"
                                              Maximum="32"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              IsEnabled="{Binding MultipleCopies}"
                                              Value="{Binding CopyLimit, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="0 = 無限。"
                                          Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="內容" Style="{StaticResource SectionHead}" />

                            <CheckBox Content="自訂變身檔"
                                      Margin="0,0,0,4"
                                      IsChecked="{Binding MorphTable, Mode=TwoWay}" />

                            <Grid Margin="24,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Editable, because the name that matters is the one in
                                    the game's directory and the list only knows what was
                                    packed beside the encoder.
                                -->
                                <ComboBox Grid.Column="0"
                                          Margin="0,0,6,0"
                                          IsEditable="True"
                                          IsEnabled="{Binding MorphTable}"
                                          ItemsSource="{Binding MorphTables}"
                                          DropDownOpened="MorphTablesOpened"
                                          Text="{Binding MorphTableName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                <ui:Button Grid.Column="1"
                                           Appearance="Secondary"
                                           ToolTip="重新掃描本工具目錄下的 .pak"
                                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                                           IsEnabled="{Binding MorphTable}"
                                           Command="{Binding DataContext.RescanMorphTablesCommand,
                                                             RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Caption}" Text="要載入哪一個變身檔,填檔名不含副檔名。留白 = 跟客戶端執行檔同名。檔案要放在遊戲目錄下,可在「變身檔」頁打包。"
                                          TextWrapping="Wrap"
                                          Margin="24,0,0,4" />

                            <ui:InfoBar Margin="24,0,0,8"
                                        Severity="Warning"
                                        IsClosable="False"
                                        Title="變身檔"
                                        Message="{Binding MorphTablesNote}"
                                        IsOpen="{Binding MorphTablesNoted, Mode=OneWay}" />

                            <CheckBox Content="動態對話檔"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding DynamicDialog, Mode=TwoWay}" />

                            <Grid Margin="{StaticResource RowSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Content="動態道具圖,pak 名"
                                          IsChecked="{Binding DynamicIcons, Mode=TwoWay}" />
                                <ui:TextBox Grid.Column="1"
                                            IsEnabled="{Binding DynamicIcons}"
                                            Text="{Binding IconPackageName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>

                            <Separator Margin="0,10" />

                            <TextBlock Text="輔助功能" Style="{StaticResource SectionHead}" />

                            <CheckBox Content="內建喝水輔助程式"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding Helper, Mode=TwoWay}" />
                            <CheckBox Content="撿取道具提示"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding PickupToast, Mode=TwoWay}" />
                            <CheckBox Content="金幣經驗值提示"
                                      Margin="{StaticResource RowSpacing}"
                                      IsChecked="{Binding GainDrift, Mode=TwoWay}" />
                            <CheckBox Content="開啟自動狩獵"
                                      Margin="{StaticResource RowSpacing}"
                                      Visibility="{Binding Helper, Converter={StaticResource BooleanToVisibility}}"
                                      IsChecked="{Binding InternalBot, Mode=TwoWay}" />

                            <Separator Margin="0,10" />

                            <TextBlock Text="文字編碼" Style="{StaticResource SectionHead}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="客戶端字串的解碼方式。「自動判斷」會依序嘗試。"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Encodings}"
                                      SelectedItem="{Binding Encoding, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EncodingName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Launcher ==================== -->
            <TabItem Header="登入器"
                     lui:Rail.Icon="{ui:SymbolIcon Link24}"
                     lui:Rail.Note="網址與公告">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel DataContext="{Binding Launcher}">
                        <TextBlock Text="外觀" Style="{StaticResource SectionHead}" />

                        <Grid Margin="{StaticResource RowSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding Skins}"
                                      SelectedItem="{Binding Skin, Mode=TwoWay}" />
                            <ui:Button Grid.Column="1"
                                       Margin="0,0,8,0"
                                       Appearance="Secondary"
                                       Content="重新掃描"
                                       Command="{Binding RescanCommand}" />
                            <ui:Button Grid.Column="2"
                                       Appearance="Secondary"
                                       Content="開啟資料夾"
                                       Command="{Binding OpenFolderCommand}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Margin="0,0,8,0"
                                        PlaceholderText="選定外觀的背景圖片"
                                        Text="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1"
                                       Margin="0,0,8,0"
                                       Appearance="Secondary"
                                       Content="瀏覽"
                                       Command="{Binding BrowseBackgroundCommand}" />
                            <ui:Button Grid.Column="2"
                                       Appearance="Secondary"
                                       Content="套用"
                                       Command="{Binding ApplyBackgroundCommand}" />
                        </Grid>

                        <Separator Margin="0,12" />

                        <TextBlock Text="連結" Style="{StaticResource SectionHead}" />

                        <CheckBox Content="啟動時開啟公告網頁"
                                  Margin="{StaticResource RowSpacing}"
                                  IsChecked="{Binding Announcement, Mode=TwoWay}" />
                        <ui:TextBox Margin="24,0,0,8"
                                    IsEnabled="{Binding Announcement}"
                                    PlaceholderText="https://…"
                                    Text="{Binding AnnouncementUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox Content="從網址更新伺服器列表"
                                  Margin="{StaticResource RowSpacing}"
                                  IsChecked="{Binding ListUpdate, Mode=TwoWay}" />
                        <ui:TextBox Margin="24,0,0,8"
                                    IsEnabled="{Binding ListUpdate}"
                                    PlaceholderText="https://…"
                                    Text="{Binding ListUpdateUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox Content="從網址自動更新客戶端"
                                  Margin="{StaticResource RowSpacing}"
                                  IsChecked="{Binding AutoUpdate, Mode=TwoWay}" />
                        <ui:TextBox Margin="24,0,0,8"
                                    IsEnabled="{Binding AutoUpdate}"
                                    PlaceholderText="https://…"
                                    Text="{Binding AutoUpdateUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <Separator Margin="0,12" />

                        <TextBlock Text="上方連結" Style="{StaticResource SectionHead}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="留白則登入器隱藏該連結。"
                                      Margin="0,0,0,8" />

                        <Grid Margin="{StaticResource RowSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="官網" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding OfficialUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="客服" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Grid.Column="1"
                                        Text="{Binding SupportUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Keys ==================== -->
            <TabItem Header="金鑰"
                     lui:Rail.Icon="{ui:SymbolIcon Key24}"
                     lui:Rail.Note="封包加密用">
                <StackPanel Margin="12">
                    <TextBlock Text="伺服器綁定金鑰" Style="{StaticResource SectionHead}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                  Margin="0,0,0,12"
                                  Text="一組金鑰套用到列表裡的每一台伺服器。產生後，伺服器那一半會寫到本工具旁邊的 pack.properties，把它放進伺服器的 ./config/ 目錄；客戶端那一半要按「儲存」寫進 list.txt。兩邊對不起來，伺服器會拒絕連線。三個欄位留白表示不使用金鑰，也可以從備份手動填回。" />

                    <Grid Margin="{StaticResource RowSpacing}" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="E" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding RsaE, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Margin="{StaticResource RowSpacing}" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="D" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding RsaD, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Margin="0,0,0,16" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="N" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding RsaN, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <CheckBox Margin="0,0,0,4"
                              Content="封包加密(沒有勾選的話,金鑰不會生效)"
                              IsChecked="{Binding Aux.PacketEncrypt, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="與「客戶端」頁的同一個設定。"
                                  Margin="24,0,0,12" />

                    <ui:Button HorizontalAlignment="Left"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Key24}"
                               Content="產生新金鑰"
                               Command="{Binding GenerateKeyCommand}" />

                    <ui:InfoBar Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                MaxWidth="560"
                                Severity="Warning"
                                IsClosable="False"
                                Title="金鑰不會生效"
                                Message="{Binding KeyWarning}"
                                IsOpen="{Binding KeyWarned, Mode=OneWay}" />
                </StackPanel>
            </TabItem>

            <!-- ==================== Morph ==================== -->
            <TabItem Header="變身檔"
                     lui:Rail.Icon="{ui:SymbolIcon Box24}"
                     lui:Rail.Note="打包與動作時間">
                <StackPanel Margin="12" DataContext="{Binding Morph}">
                    <TextBlock Text="變身檔" Style="{StaticResource SectionHead}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                  Margin="0,0,0,12"
                                  Text="記載每個 sprite 長什麼樣、動作播多久的文字檔。登入器讀的是打包後的版本;伺服器要的是動作時間表 SQL。" />

                    <Grid Margin="{StaticResource RowSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Margin="0,0,8,0"
                                    PlaceholderText="TW13081901.txt"
                                    Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Secondary"
                                   Content="瀏覽"
                                   Command="{Binding BrowseCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Archive24}"
                                   Content="打包給登入器"
                                   Command="{Binding EncodeCommand}" />
                        <ui:Button Margin="0,0,8,0"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Database24}"
                                   Content="產生 spr_action.sql"
                                   Command="{Binding GenerateSqlCommand}" />
                        <ui:Button Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   Content="檢查打包檔"
                                   Command="{Binding VerifyCommand}" />
                    </StackPanel>

                    <ui:InfoBar Margin="0,16,0,0"
                                Severity="Informational"
                                IsClosable="False"
                                Title="執行結果"
                                Message="{Binding Report}"
                                IsOpen="{Binding Report, Converter={StaticResource TextPresent}, Mode=OneWay}" />
                </StackPanel>
            </TabItem>

            <!-- ==================== Icons ==================== -->
            <TabItem Header="動態道具圖"
                     lui:Rail.Icon="{ui:SymbolIcon Image24}"
                     lui:Rail.Note="道具圖示打包">
                <Grid Margin="12" DataContext="{Binding Icons}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Three steps, in the order they are done, each one its own group.

                        It was one grid of nine columns before, with two rows of fields
                        that lined up with nothing and a button pushed off the right edge
                        of the window. Nothing said which field belonged to the package and
                        which to the entry being built, and the list — the point of the
                        page — was the thing with no heading at all.
                    -->

                    <lui:Section Grid.Row="0"
                                 Header="這個 pak"
                                 Note="打包出來的檔名,以及裡面第一張圖的編號 —— 之後每張依序往上加。">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <lui:FieldRow Header="pak 名" LabelWidth="96">
                                    <ui:TextBox Width="240"
                                                HorizontalAlignment="Left"
                                                Text="{Binding PackageName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </lui:FieldRow>

                                <lui:FieldRow Header="PNG 起始編號" LabelWidth="96">
                                    <ui:NumberBox Minimum="0"
                                                  Maximum="4294967295"
                                                  MaxDecimalPlaces="0"
                                                  ClearButtonEnabled="False"
                                                  ValidationMode="InvalidInputOverwritten"
                                                  Value="{Binding FirstImageId, Mode=TwoWay}" />
                                </lui:FieldRow>
                            </StackPanel>

                            <ui:Button Grid.Column="1"
                                       VerticalAlignment="Top"
                                       Appearance="Secondary"
                                       HorizontalContentAlignment="Center"
                                       Content="開啟既有 pak…"
                                       Command="{Binding OpenPackageCommand}" />
                        </Grid>
                    </lui:Section>

                    <lui:Section Grid.Row="1"
                                 Header="加一張動態圖"
                                 Note="速度是每一幀停多久,間隔是播完一輪歇多久(0 是不歇)。同一個 gfxid 再加一次就是取代。">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <lui:FieldRow Grid.Row="0" Grid.Column="0"
                                          Margin="0,0,20,10"
                                          Header="目標 gfxid"
                                          LabelWidth="76">
                                <ui:NumberBox Minimum="1"
                                              Maximum="65535"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding Icon, Mode=TwoWay}" />
                            </lui:FieldRow>

                            <lui:FieldRow Grid.Row="0" Grid.Column="1"
                                          Margin="0,0,20,10"
                                          Header="速度 ms"
                                          LabelWidth="72">
                                <ui:NumberBox Minimum="1"
                                              Maximum="65535"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding FrameMilliseconds, Mode=TwoWay}" />
                            </lui:FieldRow>

                            <lui:FieldRow Grid.Row="0" Grid.Column="2"
                                          Margin="0,0,0,10"
                                          Header="間隔 ms"
                                          LabelWidth="72">
                                <ui:NumberBox Minimum="0"
                                              Maximum="600000"
                                              MaxDecimalPlaces="0"
                                              ClearButtonEnabled="False"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding RestMilliseconds, Mode=TwoWay}" />
                            </lui:FieldRow>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4"
                                        Orientation="Horizontal">
                                <ui:Button Appearance="Secondary"
                                           Width="132"
                                           HorizontalContentAlignment="Center"
                                           Content="選 PNG 幀…"
                                           Command="{Binding PickFramesCommand}" />

                                <TextBlock Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,16,0"
                                           Text="{Binding PendingSummary}" />

                                <ui:Button Appearance="Primary"
                                           Width="132"
                                           HorizontalContentAlignment="Center"
                                           Content="新增／取代"
                                           Command="{Binding AddEntryCommand}" />
                            </StackPanel>
                        </Grid>
                    </lui:Section>

                    <lui:Section Grid.Row="2"
                                 Margin="0"
                                 Header="這個 pak 的內容"
                                 Note="打包後就是客戶端看到的動態道具圖。">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <ui:Button HorizontalAlignment="Left"
                                           Width="96"
                                           Appearance="Secondary"
                                           HorizontalContentAlignment="Center"
                                           Content="移除"
                                           Command="{Binding RemoveEntryCommand}" />

                                <ui:Button HorizontalAlignment="Right"
                                           Width="132"
                                           Appearance="Primary"
                                           HorizontalContentAlignment="Center"
                                           Content="打包…"
                                           Command="{Binding PackCommand}" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Entries}"
                                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     DisplayMemberPath="Label" />
                        </DockPanel>
                    </lui:Section>

                    <ui:InfoBar Grid.Row="3"
                                Margin="0,12,0,0"
                                Severity="Informational"
                                IsClosable="False"
                                Title="上次結果"
                                Message="{Binding Report}"
                                IsOpen="{Binding Report, Converter={StaticResource TextPresent}, Mode=OneWay}" />
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ==================== Footer ==================== -->
        <Grid Grid.Row="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- What the last action did, and nothing else. Where the files live is not
                 news: the operator is standing in that folder. -->
            <TextBlock Grid.Column="0"
                       Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       TextWrapping="Wrap"
                       Text="{Binding Report}" />

            <ui:Button Grid.Column="1"
                       Margin="0,0,8,0"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Content="重新載入"
                       Command="{Binding ReloadCommand}" />

            <ui:Button Grid.Column="2"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Content="儲存"
                       Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
