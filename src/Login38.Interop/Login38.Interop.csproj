<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Win32 surface. Source-generated P/Invoke ([LibraryImport]) plus SafeHandle
    wrappers so process, thread and remote-allocation lifetimes are deterministic
    instead of relying on hand-placed CloseHandle calls.
  -->

  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Login38.Core\Login38.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
